"""Copy to local_secrets.py and override only settings needed on this host."""

# Local Mac popup. For a Pi backend, change POPUP_BACKEND_URL to its LAN URL;
# a non-local URL never starts a backend on the Mac.
APP_MODE = "popup"
SERVER_HOST = "127.0.0.1"
SERVER_PORT = 8000
SERVER_API_TOKEN = ""
POPUP_BACKEND_URL = "http://127.0.0.1:8000"
PUBLIC_API_ENABLED = False

# Trusted-LAN Raspberry Pi values (use these instead of the Mac values above):
# APP_MODE = "server"
# SERVER_HOST = "0.0.0.0"
# SERVER_PORT = 8000
# SERVER_API_TOKEN = ""
# PUBLIC_API_ENABLED = False
#
# Optional authenticated LAN mode: set the same non-empty SERVER_API_TOKEN on
# the Pi and Mac. Public API deployments must also follow the stricter settings
# in docs/public-demo-deployment.md.

# Discord is a thin client of the shared server.
DISCORD_BOT_TOKEN = ""
DISCORD_PREFIX = "!akane"
DISCORD_ALLOWED_CHANNEL_IDS = ""
DISCORD_REPLY_TO_DMS = True
DISCORD_SERVER_URL = "http://127.0.0.1:8000"

# Local instruction-tuned GGUF with an embedded chat template.
MODEL_PATH = "models/Qwen3.5-9B-Q4_K_M.gguf"
LLAMA_ENABLE_THINKING = False
LLAMA_CONTEXT_WINDOW = 4096
# Apple Silicon defaults enable Metal; Pi defaults retain its CPU settings.
# Leave threads, batch, ubatch, offload, flash attention, SWA, and KV types unset
# to use those platform defaults.

# One direct generation configuration.
MAX_TOKENS = 96
TEMPERATURE = 0.98
TOP_K = 64
TOP_P = 0.93
MIN_P = 0.04
REPETITION_PENALTY = 1.10

# Bounded state and conversation selection.
DATA_DIR = "data"
RECENT_TURN_LIMIT = 16
RECENT_CONVERSATION_BUDGET = 360
MEMORY_MAX_RESULTS = 2
SELF_MAX_RESULTS = 2
MAX_PENDING_GENERATIONS = 4
